/*
  A fixture covering every rule in the grammar. Open it with the extension
  installed to see what a theme does with ceps, or feed it to the tokenizer
  check in README.md after regenerating the grammar.
*/

kind Event;
kind Sensor;

Event E, F;
Sensor front, rear;

// Names that are really SI units. These do not mean what they look like --
// see DEFECTS.md D17 -- so the grammar gives them their own scope.
Sensor m, s, kg, mol, cd;       // all five bind to units, silently
Sensor A, K, g;                 // these three are fine

val threshold = 42;
val ratio = 3.14;
val label_text = "a string with an \"escape\" in it";

val derived = threshold * 2;
let derived = derived + 1;

static_for (e : root.config.entry) {
    seen { e.content(); };
}

if (threshold > 40) { chosen{"high";}; } else { chosen{"low";}; }

oblectamenta {
    global {
        data {
            OblectamentaDataLabel i, n, one, greeting;
            i;   0;
            n;   100;
            one; 1;
            greeting; "hello";
        };
    };
};

sm {
    Counter;
    states { Initial; Count; Done; };

    Actions {
        increment {
            oblectamenta { text { asm {
                OblectamentaDataLabel i, n, one;
                OblectamentaCodeLabel done;

                ldi32(i);
                ldi32(n);
                blteq(done);        // i >= n
                ldi32(i);
                ldi32(one);
                addi32;
                sti32(i);
                E;
                halt;
                done;
                dbg_printlni32(i);
                F;
            };};};
        };
    };

    t { Initial; Count; increment; };
    t { Count; Count; E; increment; };
    t { Count; Done; F; };
};

Simulation { Start { Counter; }; };
